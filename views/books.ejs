
<%- include('partials/header.ejs') %>
<%- include('partials/main.nav.ejs') %>

<main class="books-page">
    <h1>Collection</h1>
    <p>Keep track of all books in your collection</p>
    <a href="/books/add">Add Book</a>
    <table>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>

        <% books.forEach(function(book, index) { %>
            <tr>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td><%= book.genre %></td>
                <td><%= book.status %></td>
                <a href="/books/edit/<%= index %>">Edit</a>
                <td>
                    <form action="/books/delete/<%= index %>" method="POST">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>
</main>
<%- include('partials/footer.ejs') %>